{
  "name": "careid-kiosk-bridge",
  "version": "0.2.0-test.1",
  "description": "CareID Kiosk - native Windows app with embedded USB NFC bridge",
  "main": "src/main.js",
  "private": true,
  "author": "Neuvo / CareID",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "nfc-pcsc": "^0.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.careidtag.kioskbridge",
    "productName": "CareID Kiosk Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "CareID",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CareID Kiosk Bridge",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gabrielfds",
        "repo": "careid-kiosk-bridge-releases",
        "releaseType": "release"
      }
    ]
  }
}
