{
  "name": "neuvo-care-kiosk-bridge",
  "version": "0.1.0",
  "description": "Neuvo Care Kiosk Bridge for USB NFC readers",
  "main": "src/main.js",
  "private": true,
  "author": "Neuvo",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish never",
    "preinstall": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"choco install visualstudio2022buildtools visualstudio2022-workload-vctools -y --no-progress --package-parameters \"\"--passive --norestart\"\"\""
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "nfc-pcsc": "^0.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.neuvo.care.kioskbridge",
    "productName": "Neuvo Care Kiosk Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "Neuvo",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neuvo Care Kiosk Bridge",
      "runAfterFinish": true
    }
  },
  "overrides": {
    "node-gyp": "^11.5.0"
  }
}
